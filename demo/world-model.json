    "seed_route": "cargo run -p chimiaclaw-cli -- node seed-route --store-dir \"$STORE\"",
    "run_all": "cargo run -p chimiaclaw-cli -- node run --store-dir \"$STORE\" --max-cycles 3 --interval-ms 0",
    "inspect": "cargo run -p chimiaclaw-cli -- artifact inspect --store-dir \"$STORE\"",
