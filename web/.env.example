# Public API gateway (services/api-gateway)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:4021

# Display-only badges (must match gateway config in production)
NEXT_PUBLIC_X402_MODE=stub
NEXT_PUBLIC_PAY_TO=0xYourDaoTreasuryOnBase
NEXT_PUBLIC_NETWORK=eip155:84532

# WalletConnect (optional — wallet button degrades without a real project id)
NEXT_PUBLIC_WC_PROJECT_ID=demo

# Display-only human rails (gateway holds secrets)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_REVOLUT_PAYMENT_LINK=https://revolut.me/...

# Optional: static demo assets if you host world-map / DFT gallery from this app
# NEXT_PUBLIC_DEMO_BASE=/demo
