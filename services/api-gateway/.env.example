# Gateway
PORT=4021
HOST=0.0.0.0
CORS_ORIGIN=*

# x402 mode: free | stub | live
# free  = no payment (local UI wiring)
# stub  = returns HTTP 402 shape; accepts PAYMENT-SIGNATURE: stub (no funds)
# live  = real facilitator + USDC (requires payTo + optional @x402 packages)
X402_MODE=stub

# DAO treasury receiving address (Base). Required for live; shown in catalog for stub.
CHIMIA_X402_PAY_TO=0xYourDaoTreasuryOnBase

# CAIP-2 network. Base Sepolia testnet by default.
# Base Sepolia: eip155:84532
# Base mainnet: eip155:8453
X402_NETWORK=eip155:84532

# Test facilitator (testnet only). For mainnet use a production facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Path to chimiaclaw-cli binary (built via cargo build -p chimiaclaw-cli)
CHIMIACLAW_CLI=../../target/debug/chimiaclaw-cli

# Optional: directory to append JSONL revenue / paid-job events
REVENUE_LOG_PATH=./data/revenue.jsonl

# Signed chem.dft.result gallery used by GET /v1/dft/cached (and free /v1/dft/index)
DFT_CACHE_DIR=../../demo/dft

# Public URL of this gateway (OpenAPI servers + Stripe redirects)
PUBLIC_BASE_URL=http://127.0.0.1:4021

# Rate limit (per IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Human payment rails (optional; agents use x402) ---
# Stripe — easiest: Payment Links from Dashboard → Payment links → Create
# https://dashboard.stripe.com/payment-links/create
# After create, copy the buy.stripe.com URL:
# STRIPE_PAYMENT_LINK_MOLADT=https://buy.stripe.com/...
# STRIPE_PAYMENT_LINK_DFT_CACHED=https://buy.stripe.com/...
# Optional API Checkout (instead of / in addition to links):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Revolut personal wallet / payment link (manual settlement)
# REVOLUT_PAY_TO=your@revolut.tag or IBAN note
# REVOLUT_PAYMENT_LINK=https://revolut.me/yourhandle
# REVOLUT_NOTE=Include order reference in the transfer description
