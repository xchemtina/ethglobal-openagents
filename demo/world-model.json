  "abstraction_principles": [
    {
      "id": "PRINCIPLE.ARTIFACT_DAG_FIRST",
      "label": "Artifact DAG first",
      "description": "The UI may filter, cluster, or project artifacts, but it must not invent state outside signed payload-bound lineage."
    },
    {
      "id": "PRINCIPLE.CUSTODY_BEFORE_AUTONOMY",
      "label": "Custody before autonomy",
      "description": "Virtual agents may propose; physical custody and wetlab execution require human gates and explicit trust edges."
    },
    {
      "id": "PRINCIPLE.MSSP_AS_GENEALOGY",
      "label": "MSSP as genealogy",
      "description": "Optimization generations are artifact families: primitive, crossover, fitness, tournament, terminal-check, and switcher decisions become signed child artifacts."
    },
    {
      "id": "PRINCIPLE.WORLD_AVATAR_AS_PROJECTION",
      "label": "World Avatar as projection",
      "description": "RDF/PROV-O/OntoChimia triples project signed artifacts into semantic space without replacing the artifact DAG as canonical state."
    },
    {
      "id": "PRINCIPLE.FAIL_CLOSED_UNKNOWN_CHEMISTRY",
      "label": "Fail closed on unknown chemistry",
      "description": "Missing identity, payload, SDS, or parent lineage should render as blocked/quarantined until reviewed."
    }
  ],
