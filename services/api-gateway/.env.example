# Gateway
PORT=4021
HOST=0.0.0.0
CORS_ORIGIN=*

# x402 mode: free | stub | live
# free  = no payment (local UI wiring)
# stub  = returns HTTP 402 shape; accepts PAYMENT-SIGNATURE: stub (no funds)
# live  = x402 unavailable; valid separately issued fulfillment tokens remain usable
X402_MODE=stub

# DAO treasury receiving address (Base). Required for live; shown in catalog for stub.
CHIMIA_X402_PAY_TO=0xYourDaoTreasuryOnBase

# CAIP-2 network. Base Sepolia testnet by default.
# Base Sepolia: eip155:84532
# Base mainnet: eip155:8453
X402_NETWORK=eip155:84532

# Test facilitator (testnet only). For mainnet use a production facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Path to chimiaclaw-cli binary (built via cargo build -p chimiaclaw-cli)
CHIMIACLAW_CLI=../../target/debug/chimiaclaw-cli

# Optional: directory to append JSONL revenue / paid-job events
REVENUE_LOG_PATH=./data/revenue.jsonl

# Signed chem.dft.result gallery used by GET /v1/dft/cached (and free /v1/dft/index)
# Colon-separated dirs OK (recursive scan):
DFT_CACHE_DIR=../../demo/dft:../../demo/overnight-science-out/dft:../../demo/overnight-full-out/dft:../../demo/sellable-dft
# Human catalog prices (match Stripe Payment Link amounts)
MOLADT_PRICE_DISPLAY=$1.00
MOLADT_PRICE_MICROS=1000000
# Match Stripe Payment Link amount for cached DFT ($5 live link)
DFT_CACHED_PRICE_DISPLAY=$5.00
DFT_CACHED_PRICE_MICROS=5000000
# Skala-1.1 premium singles ($20). Packs use this unit × discount.
DFT_SKALA_PRICE_DISPLAY=$20.00
DFT_SKALA_PRICE_MICROS=20000000
# Agent credits: classical single = 1 credit; Skala single = 4 credits
DFT_PACK_DISCOUNT=0.8
DFT_CREDIT_DISCOUNT=0.85

# Public URL of this gateway (OpenAPI servers + Stripe redirects)
PUBLIC_BASE_URL=http://127.0.0.1:4021

# Rate limit (per IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# --- Human payment rails (optional; agents use x402) ---
# Stripe — easiest: Payment Links from Dashboard → Payment links → Create
# https://dashboard.stripe.com/payment-links/create
# After create, copy the buy.stripe.com URL (public; safe to commit):
# Chimia live Payment Link (both SKUs until split prices):
STRIPE_PAYMENT_LINK_MOLADT=https://buy.stripe.com/5kQ28sahM1zR3mO3gB5Rm00
STRIPE_PAYMENT_LINK_DFT_CACHED=https://buy.stripe.com/5kQ28sahM1zR3mO3gB5Rm00
# Optional API Checkout (instead of / in addition to links):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook → fulfillment tokens (from `stripe listen` or Dashboard endpoint secret):
# STRIPE_WEBHOOK_SECRET=whsec_...
# FULFILLMENT_LOG_PATH=./data/fulfillment-tokens.jsonl
# FULFILLMENT_TTL_SECONDS=86400
# Operator mint after Stripe email (no webhook): long random secret
# OPERATOR_FULFILL_SECRET=
# Redeem: PAYMENT-SIGNATURE: fulfill:ft_… on POST /v1/moladt or GET /v1/dft/cached

# Revolut personal wallet / payment link (manual settlement — privacy: off by default)
# REVOLUT_PAY_TO=your@revolut.tag or IBAN note
# REVOLUT_PAYMENT_LINK=https://revolut.me/yourhandle
# REVOLUT_NOTE=Include order reference in the transfer description

# Unstoppable Domains crypto rail (human + optional agent pay_to alignment)
UD_DOMAIN=chimiadao.dao
# Paste ETH/EVM address from Unstoppable wallet for chimiadao.dao (required for live checkout):
# UD_EVM_ADDRESS=0xYourTreasuryOnBaseOrEth
# Preferred network CAIP-2 (Base mainnet default) and token buyers should send:
UD_PREFERRED_NETWORK=eip155:8453
UD_TOKEN=USDC
# Optional: Partner API key to resolve records live instead of pinning UD_EVM_ADDRESS
# UNSTOPPABLE_API_KEY=
# Tip: set CHIMIA_X402_PAY_TO to the same 0x so agents and humans share one treasury.

# Resource limits; run one process per fulfillment ledger.
RATE_LIMIT_MAX_KEYS=10000
MOLADT_TIMEOUT_MS=30000
MOLADT_MAX_OUTPUT_BYTES=4194304
MOLADT_MAX_CONCURRENT=4
